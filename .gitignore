# 点开头的文件/目录一律不入库：IDE 状态、助手记忆、缓存、本地配置。
# 已被跟踪的 .gitignore / .gitattributes / .env.example / web/.postcssrc.json /
# web/public/families/.gitkeep 不受影响；以后新增点开头的文件要 git add -f。
.*

# 运行时状态：不可重建，需要备份
var/

# ComfyUI 运行时：可重建（只忽略根目录，避免误伤 backend/app/comfy 源码）
/comfy/

# 用户资产：模型 / 插件 / 工作流 / 出图，运行时数据不进版本库
/workspace/

# 旧 demo 下载目录（可重下，内容已迁往 workspace/models）
/models/

# 部署配置
.env

# Python
.venv/
__pycache__/
*.pyc

# 前端
node_modules/
web/dist/
web/dist-tmp/
web/.angular/
*.tsbuildinfo
# 构建窗口期挪 dist 的临时位置
web/dist-old/

# 测试产物（不限层级：从根目录跑测试也会在此生成）
artifacts/
test-results/
playwright-report/
# tests/ 根层的一次性调试 / 截图脚本（E2E 用例是 tests/e2e/ 下的 .ts，不受影响）
tests/*.mjs
# 例外：这几支是**长期校验脚本**，不是一次性调试 —— 丢了机制就没人跑了
!tests/families-assets.mjs
!tests/family-table-sync.mjs
!tests/wt-ink.mjs
!tests/wt-tune.mjs
# 例外：CNB 的 CI 配置必须入库。`.*` 规则会把它挡掉，但 CI 配置不跟着仓库走，
# 门禁就等于没有 —— 那正是这套机制当初缺的那一环。
!.cnb.yml
# 临时素材候选与抓取快照
web/public/**/_candidates/
/wf.tmp.json

# VIS/LOGO 设计过程中的中间产物：素材稿、字体试用、一次性脚本。
# 定稿资产在 web/public/brand/，这里只放「还没进产品」的过程材料。
/designkit-artifacts/
/logo-vector/
/grad_demo_tmp.py

# IDE 助手的工作记忆：与项目源码无关，只在本地保留
.workbuddy/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
