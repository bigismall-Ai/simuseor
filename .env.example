# 部署配置模板：复制为 .env 后按实际环境修改
# 所有路径都可覆盖，代码里不硬编码

# 项目根（相对或绝对均可）
SIMUSEOR_ROOT=.

# 各层目录（留空则用默认值：ROOT/var、ROOT/models、ROOT/comfy）
# SIMUSEOR_VAR=
# SIMUSEOR_MODELS=
# SIMUSEOR_COMFY=

# 服务监听
SIMUSEOR_HOST=127.0.0.1
SIMUSEOR_PORT=8000

# ComfyUI 代码来源（CNB 镜像优先，GitHub 兜底）
COMFY_MIRROR=https://cnb.cool/bigismall/Comfy-Org/ComfyUI.git
COMFY_FALLBACK=https://github.com/Comfy-Org/ComfyUI.git

# ComfyUI 实例监听（仅本机，由后端代理）
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
