{
  "name": "view",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/svg-index.mjs && node scripts/card-guard.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/svg-index.mjs && node scripts/card-guard.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "svg:index": "node scripts/svg-index.mjs",
    "test": "ng test",
    "cards:guard": "node scripts/card-guard.mjs",
    "lint": "ng lint",
    "lint:rules": "node --test eslint-rules/no-unregistered-ui-element.test.mjs",
    "check": "node scripts/svg-index.mjs && node scripts/card-guard.mjs && npm run lint"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.8.0",
    "@angular-eslint/utils": "^22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2"
  }
}
